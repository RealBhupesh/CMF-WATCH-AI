{
  "name": "job-crawler-mcp-server",
  "version": "0.1.0",
  "description": "Persistent browser-control MCP server for business workflows, local job search, form filling, and audited applications.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "job-crawler-mcp": "dist/index.js"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx src/index.ts --http",
    "dev:stdio": "tsx src/index.ts --stdio",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js --http",
    "start:stdio": "node dist/index.js --stdio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "playwright:install": "playwright install chromium",
    "smoke": "tsx scripts/smoke.ts",
    "doctor": "tsx scripts/doctor.ts",
    "tunnel:setup": "bash scripts/setup-tunnel.sh",
    "launchd:install": "bash scripts/install-launchagents.sh",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.13",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}

# Copy to .env or run: npm run setup
DATA_DIR=data
LOG_LEVEL=info
BROWSER_HEADLESS=false
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8787
MCP_PUBLIC_URL=https://YOUR-DOMAIN.example.com
MCP_OWNER_PASSWORD=replace-with-at-least-12-characters
MCP_JWT_SECRET=replace-with-at-least-32-characters
# MCP_ALLOWED_HOSTS=extra.example.com
# MCP_ALLOWED_ORIGINS=extra.example.com
# MCP_TOKEN_TTL_SECONDS=3600
# MCP_REFRESH_TTL_DAYS=30
# MAX_UPLOAD_MB=10
# MAX_SNAPSHOT_ELEMENTS=200
# MAX_TEXT_CHARS=20000
# BROWSER_MAX_TABS=10
# BROWSER_MAX_SESSIONS=3
# MAX_STORED_FILES_MB=500
# MAX_UPLOAD_MB applies to each managed upload or saved download.
# MAX_TEXT_CHARS also caps each watch baseline and page read.
# MCP_MAX_REQUEST_BYTES defaults to enough for a max-size base64 upload.
# Render supplies PORT and RENDER_EXTERNAL_URL automatically.
# MCP_HTTP_PORT and MCP_PUBLIC_URL take precedence when explicitly configured.
# On Render use a persistent disk mounted at /app/data and DATA_DIR=/app/data.

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "paths": {
      "@/*": ["./src/worker/*"]
    }
  },
  "include": ["src/worker", "worker-test"]
}
